# ------------------------------------------------------------
# Basic Auth for teammates (shared password) — same pattern as the AM Ticket Journey dashboard.
# ------------------------------------------------------------
DASHBOARD_USER=zoca
DASHBOARD_PASSWORD=change-me-please

# ------------------------------------------------------------
# Chargebee — live subscription source of truth
# ------------------------------------------------------------
CHARGEBEE_SITE=zoca
CHARGEBEE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Metabase — comms CSVs + BaseSheet entity mapping
# The public CSV endpoints are hard-coded in lib/config.ts (they're UUIDs that don't change).
# ------------------------------------------------------------
# (no Metabase env required — endpoints are public)

# ------------------------------------------------------------
# Cron auth — Vercel Cron sends Authorization: Bearer $CRON_SECRET
# Generate a strong random string, e.g. `openssl rand -hex 32`
# ------------------------------------------------------------
CRON_SECRET=change-me-too

# ------------------------------------------------------------
# Vercel KV (auto-injected when you attach a KV database to the project)
# ------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_URL=
