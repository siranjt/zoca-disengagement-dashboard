{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "app/api/cron/refresh/route.ts": {
      "memory": 2048,
      "maxDuration": 90
    },
    "app/api/snapshot/route.ts": {
      "memory": 2048,
      "maxDuration": 90
    },
    "app/api/v2/snapshot/route.ts": {
      "memory": 2048,
      "maxDuration": 90
    }
  }
}
